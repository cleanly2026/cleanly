# ============================================================================
# Cleanly Customer Web (Next.js) — Environment Variables
# Copy to .env.local (Next.js convention). Do NOT commit.
# ============================================================================

# --- API URL (public — browser will call this) ---
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Stripe (publishable key only — safe to expose) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Sentry (error tracking) ---
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
