# ============================================================================
# Cleanly Admin Web (Next.js) — Environment Variables
# Copy to .env.local (Next.js convention). Do NOT commit.
# ============================================================================

# --- API URL (public — browser will call this) ---
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Sentry (error tracking) ---
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX

# --- NextAuth.js (Google SSO for admin login) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3003

# --- Google OAuth (for admin SSO) ---
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- HMAC bridge to Fastify API (must match ADMIN_EXCHANGE_SECRET in apps/api/.env) ---
ADMIN_EXCHANGE_SECRET=
