# ============================================================================
# Cleanly Customer Mobile (Expo) — Environment Variables
# Copy to .env (Expo reads from .env in dev). Do NOT commit.
# Only EXPO_PUBLIC_* vars are embedded in the app bundle.
# ============================================================================

# --- API URL ---
# Dev: http://localhost:3000 (or your machine IP for physical device testing)
# Staging: https://cleanly-api-staging.fly.dev
# Production: https://cleanly-api.fly.dev
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- EAS Project ID (set automatically by `eas init`) ---
EXPO_PUBLIC_PROJECT_ID=4b6cf4d4-8d8f-41a4-bf1d-346cbdad706b

# --- Stripe (publishable key only) ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Sentry ---
EXPO_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
