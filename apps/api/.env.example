# ============================================================================
# Cleanly API — Environment Variable Template
# Copy to .env and fill in values. Do NOT commit .env (it is gitignored).
# ============================================================================

# --- Runtime ---
NODE_ENV=development               # development | staging | production
PORT=3000                          # API server port
HOST=0.0.0.0                       # Bind host
LOG_LEVEL=info                     # trace | debug | info | warn | error | fatal

# --- Database (Neon PostgreSQL) ---
# Get both from Neon dashboard: https://console.neon.tech
# Pooled URL has "-pooler" in hostname; direct URL does not.
# REQUIRED: pooled for runtime, direct for Prisma migrations.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Redis (Upstash Fixed Plan) ---
# Get from https://console.upstash.com
# CRITICAL: use Fixed Plan ($10/mo), NOT Pay-As-You-Go — BullMQ polling blows up PAYG billing
UPSTASH_REDIS_URL=rediss://default:token@xxx.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- JWT (Authentication) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Twilio (SMS + OTP) ---
# https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VA...
TWILIO_PHONE_NUMBER=+971...       # UAE number for SMS sending

# --- Stripe (Payments + Connect) ---
# https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...      # Use sk_live_... in production
STRIPE_WEBHOOK_SECRET=whsec_...    # Generated when webhook endpoint is registered

# --- Resend (Transactional Email) ---
# https://resend.com
RESEND_API_KEY=re_...

# --- 360dialog (WhatsApp Business) ---
# https://hub.360dialog.com
# NOTE: Message templates take 1-2 weeks to approve — submit early
DIALOG360_API_KEY=

# --- Cloudflare R2 (Photo Storage) ---
# https://dash.cloudflare.com → R2
# IMPORTANT: Set bucket CORS AllowedHeaders to ["content-type"], NOT ["*"]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cleanly-photos
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Sentry (Error Tracking) ---
# https://sentry.io → Settings → Projects → cleanly-api → Client Keys (DSN)
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
SENTRY_ORG=cleanly
# Auth token for source map uploads in CI
# Create at: Sentry → Settings → Auth Tokens (scopes: project:releases, project:read)
SENTRY_AUTH_TOKEN=sntrys_...

# --- Expo Push (optional) ---
# Only needed if using EAS access token for server-side push sending
EXPO_ACCESS_TOKEN=

# --- App URLs (for CORS + Stripe Connect redirects) ---
CUSTOMER_WEB_URL=http://localhost:3001
COMPANY_WEB_URL=http://localhost:3002
ADMIN_WEB_URL=http://localhost:3003
CUSTOMER_MOBILE_URL=http://localhost:8081
WASHER_MOBILE_URL=http://localhost:8082
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# --- Admin SSO exchange secret (HMAC bridge: Auth.js → Fastify JWT) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EXCHANGE_SECRET=

# --- Feature Flags ---
# WHATSAPP_ENABLED: set to "true" once 360dialog templates are approved by Meta.
# When true, DIALOG360_API_KEY becomes required in ALL environments.
WHATSAPP_ENABLED=false

# BYPASS_SENTRY: non-production escape hatch.
# When true in staging/dev, SENTRY_DSN is not required (useful when Sentry is misconfigured).
# IGNORED in production — SENTRY_DSN is always required in production regardless.
BYPASS_SENTRY=false
