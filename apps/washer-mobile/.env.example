# ============================================================================
# Cleanly Washer Mobile (Expo) — Environment Variables
# Copy to .env. Do NOT commit.
# Only EXPO_PUBLIC_* vars are embedded in the app bundle.
# ============================================================================

# --- API URL ---
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- EAS Project ID (set automatically by `eas init`) ---
EXPO_PUBLIC_PROJECT_ID=3ab3cf7e-8a25-4ce5-84b4-b96a2cd6d34e

# --- Google Maps API Key ---
# https://console.cloud.google.com/apis/credentials
# Restrict to Android package com.cleanly.washer
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Sentry ---
EXPO_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
