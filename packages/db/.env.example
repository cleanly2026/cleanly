# ============================================================================
# Cleanly Database — Prisma Config Template
# Copy to .env. Do NOT commit.
# ============================================================================

# Neon pooled URL — runtime queries (has "-pooler" in hostname)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct URL — for `prisma migrate deploy` and `prisma db push`
# REQUIRED: Prisma migrations do NOT work through PgBouncer pooler
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
